[Desktop Entry]
Version=1.0
Name=Jarheart
GenericName=Color temperature adjustment
Comment=Modern display color temperature manager with Wayland & Compiz integration
Exec=jarheart-gtk
Icon=jarheart
Terminal=false
Type=Application
Categories=Utility;Settings;
Keywords=color;temperature;redshift;night;light;blue;screen;display;compositor;compiz;wayland;
StartupNotify=true
X-GNOME-Autostart-enabled=true
X-KDE-autostart-after=panel
